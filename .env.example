# ============================================================
# 部署环境变量样例（复制成真实值后配到系统环境变量 / pi 启动脚本）
# ⚠️ 真实值不要提交进仓库！
# ============================================================

# --- Kali 执行机（必填）---
# 全部进攻子代理（ctf/recon/pentest/audit/forensics）的 bash 都经 SSH 到这台 Kali 执行
# 形式 "用户名@IP"，例如 "kali@192.168.1.50"
PI_KALI_HOST=kali@192.168.1.50

# Kali 的 SSH 密码
# （建议改成密钥登录：Kali 上配 authorized_keys 后，把 ctf-gate.ts / kali-exec.ts
#   里的 sshpass 段替换成 `ssh -i <私钥路径>`，然后这行就不用填）
PI_KALI_PASS=your-kali-password

# --- FOFA（可选，pentest 的 fofa_search 工具用）---
# FOFA_EMAIL=your@email.com
# FOFA_KEY=your-fofa-key

# --- 可选覆盖（不填走默认）---
# 黑板根目录（默认 D:/2026/pi-ctf/ctf-boards）
# PI_CTF_BOARDS_ROOT=D:/2026/pi-ctf/ctf-boards
# 闸门脚本 _shared 目录（默认 D:/2026/pi-ctf/_shared）
# PI_CTF_SHARED=D:/2026/pi-ctf/_shared
